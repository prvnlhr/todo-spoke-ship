APP_NAME="Todo Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
# Remote demo: ngrok http 8080  then set APP_URL to the https URL, e.g.
# APP_URL=https://abc123.ngrok-free.app

APP_ROLE=hub

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=todo_hub
DB_USERNAME=hub
DB_PASSWORD=secret

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database
