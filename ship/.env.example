APP_NAME="Todo Spoke"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_ROLE=spoke
SPOKE_ID=spoke-demo-01
HUB_URL=http://host.docker.internal:8080
# Friend in another city: use the public hub URL, e.g.
# HUB_URL=https://xxxx.ngrok-free.dev
HUB_API_TOKEN=token-demo-01
SYNC_ENABLED=true
# Local OTA demo: localhost:5000/todo-app:latest
# GitHub clone (friend): todo-app:latest after `docker build -t todo-app:latest .` from repo root
APP_IMAGE=todo-app:latest

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=todo_spoke
DB_USERNAME=todo
DB_PASSWORD=change-me-strong
DB_ROOT_PASSWORD=change-me-root-strong

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
